# Local Django process. Copy this file to .env.local and replace only the
# Railway staging public URLs and OAuth credentials below.
DJANGO_SECRET_KEY=local-development-secret-change-me
DJANGO_DEBUG=1
DJANGO_SECURE_SSL_REDIRECT=0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GAME_FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Paste the public URLs from the Railway staging database services.
DATABASE_URL=
EVENT_REDIS_URL=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback/

# Must exactly match event-server/.env.local.
EVENT_INTERNAL_SECRET=
EVENT_GAME_WS_URL=ws://localhost:8081
EVENT_AUTHORITATIVE_CORE_READY=0
