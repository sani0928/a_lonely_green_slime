# Django service
DJANGO_SECRET_KEY=replace-with-a-unique-long-random-secret
DJANGO_DEBUG=0
DJANGO_SECURE_SSL_REDIRECT=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Railway reference variables in each environment
DATABASE_URL=${{Postgres.DATABASE_URL}}
EVENT_REDIS_URL=${{Redis.REDIS_URL}}

# Google OIDC. Use a staging client or a client with the staging redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback/

# Must match the event-server value in this same environment only.
EVENT_INTERNAL_SECRET=replace-with-a-different-long-random-secret
EVENT_GAME_WS_URL=ws://localhost:8081
