# Railway deployment: use the private-network reference variable.
EVENT_REDIS_URL=${{Redis.REDIS_URL}}

# Local integration test: set EVENT_REDIS_URL to Railway staging's
# REDIS_PUBLIC_URL. Never use production values.

# Must match Django's EVENT_INTERNAL_SECRET in this same environment only.
EVENT_INTERNAL_SECRET=replace-with-a-different-long-random-secret
EVENT_FINALIZE_URL=http://localhost:8000/api/events/internal/finalize/
EVENT_ALLOWED_ORIGIN=http://localhost:5173
